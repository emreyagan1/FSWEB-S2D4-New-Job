{
  "name": "vite-starter",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest --watchAll --json --outputFile ./resultz.json -c ./jest.config.js",
    "wit": "concurrently 'npm run dev' 'npm run test'",
    "test:run": "jest --json --outputFile ./resultz.json -c ./jest.config.js --forceExit",
    "sendresults": "node sendTestResults.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.0.0",
    "vite": "^4.5.0"
  },
  "dependencies": {
    "axios": "^1.6.2"
  }
}
